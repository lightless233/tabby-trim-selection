{
  "compilerOptions": {
    "baseUrl": "src",
    "module": "es2015",
    "moduleResolution": "node",
    "target": "es2018",
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "sourceMap": true,
    "types": [],
    "lib": [
      "dom",
      "es2018"
    ]
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}
